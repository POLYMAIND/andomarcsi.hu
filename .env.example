# Az oldal nyilvános címe (Stripe visszairányításhoz és belépő linkekhez)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcionális: meglévő havi Price ID. Ha üres, az ár a NEXT_PUBLIC_SUBSCRIPTION_PRICE_HUF alapján készül.
STRIPE_SUBSCRIPTION_PRICE_ID=

# Előfizetés (alapértelmezés: bekapcsolva, 19 900 Ft/hó)
NEXT_PUBLIC_SUBSCRIPTION_ENABLED=false
NEXT_PUBLIC_SUBSCRIPTION_PRICE_HUF=14990

# AI segítő a kurzusoldalakon (Claude API) – console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Csak ha a kulcs nincs workspace-hez rendelve: a workspace azonosítója (Console → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# Napi kérdéskeret felhasználónként (alapértelmezés: 40)
AI_CHAT_DAILY_LIMIT=40

# „Értesítést kérek” feliratkozások továbbítása PolyOS-be (opcionális webhook)
POLYOS_WEBHOOK_URL=
POLYOS_WEBHOOK_SECRET=

# Billingo (automatikus számla minden sikeres fizetés után) – v3 API-kulcs: Billingo → Beállítások → API
BILLINGO_API_KEY=
# Számlatömb azonosító (nem kötelező – üresen az első számlatömböt használja)
BILLINGO_BLOCK_ID=

# Polyakadémia tagság: a heti Q&A linkje (a tagok a Saját tanulás oldalon látják). A közösség saját oldal: /kozosseg
NEXT_PUBLIC_MEMBER_QA_URL=

# Közösségi e-mail értesítések (Resend: https://resend.com) – ha üres, nem megy ki értesítés.
# A feladó domainjét a Resendben hitelesíteni kell, pl. EMAIL_FROM="Andor Marcsi <kozosseg@andormarcsi.hu>"
RESEND_API_KEY=
EMAIL_FROM=

# Meta (Facebook/Instagram) Pixel a hirdetések méréséhez – csak sütihozzájárulás után töltődik be.
# A /claude-alapozo landing a sikeres értesítéskérésnél „Lead” eseményt küld. Üresen nincs Pixel.
NEXT_PUBLIC_META_PIXEL_ID=
